{
  "manifest_version": 3,
  "name": "JoJo: sem Discord",
  "description": "Avisa o JoJo Companion quando uma aba do Discord abre e fecha só essa aba. Só enxerga endereços do Discord; não lê nenhum outro site.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["nativeMessaging", "alarms"],
  "host_permissions": ["*://discord.com/*", "*://*.discord.com/*", "*://discordapp.com/*", "*://*.discordapp.com/*"],
  "background": { "service_worker": "fundo.js" }
}
