{
  "name": "jojo-companion",
  "productName": "JoJo Companion",
  "version": "0.38.0",
  "description": "JoJo Companion: companion de desktop com o JoJo, um tubarão fisiculturista.",
  "author": "JoJo Companion contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "node test/e2e/run-e2e.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "measure": "node scripts/measure.mjs",
    "build:win": "bash scripts/build-win.sh",
    "build:dir": "bash scripts/build-win.sh --dir",
    "sheet": "electron scripts/preview-sheet.mjs"
  },
  "dependencies": {
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.0.12",
    "playwright-core": "1.63.0"
  },
  "build": {
    "appId": "com.jojocompanion.app",
    "productName": "JoJo Companion",
    "copyright": "JoJo Companion",
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "src/**/*",
      "assets/**/*",
      "!assets/**/*.md",
      "LICENSE",
      "!node_modules/@koromix/koffi-linux-*/**",
      "!node_modules/@koromix/koffi-darwin-*/**",
      "!node_modules/koffi/lib/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/koffi/doc/**",
      "!node_modules/koffi/src/koffi/src/**",
      "!node_modules/koffi/src/koffi/CMakeLists.txt"
    ],
    "asarUnpack": [
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app.ico",
      "artifactName": "JoJoCompanion-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "JoJo Companion",
      "artifactName": "JoJoCompanion-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": null,
    "portable": {
      "artifactName": "JoJoCompanion.exe",
      "unpackDirName": "JoJoCompanion"
    }
  },
  "jojoUpdate": {
    "owner": "oaovito",
    "repo": "jojo-companion-releases"
  }
}
